
SIZE = 5
queue = [None] * SIZE
front = -1
rear = -1

def enqueue(value):
    global front, rear

    if (rear + 1) % SIZE == front:
        print("Queue Overflow!")
        return

    if front == -1:
        front = 0

    rear = (rear + 1) % SIZE
    queue[rear] = value
    print(value, "inserted")

def dequeue():
    global front, rear

    if front == -1:
        print("Queue Underflow!")
        return

    print(queue[front], "deleted")

    if front == rear:
        front = rear = -1
    else:
        front = (front + 1) % SIZE

def display():
    if front == -1:
        print("Queue is empty")
        return

    print("Circular Queue:", end=" ")
    i = front

    while True:
        print(queue[i], end=" ")
        if i == rear:
            break
        i = (i + 1) % SIZE

    print()

def peek():
    if front == -1:
        print("Queue is empty")
    else:
        print("Front element:", queue[front])

while True:
    print("\n1. Enqueue")
    print("2. Dequeue")
    print("3. Display")
    print("4. Peek")
    print("5. Exit")

    choice = int(input("Enter your choice: "))

    if choice == 1:
        value = int(input("Enter value: "))
        enqueue(value)

    elif choice == 2:
        dequeue()

    elif choice == 3:
        display()

    elif choice == 4:
        peek()

    elif choice == 5:
        print("Program terminated")
        break

    else:
        print("Invalid choice!")
